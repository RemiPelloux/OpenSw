<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingTop="12dp">

    <View
        android:id="@+id/cockpit_focus_rail"
        android:layout_width="4dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:background="@color/opensw_cyan"
        app:layout_constraintBottom_toBottomOf="@id/cockpit_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cockpit_header" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cockpit_header"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/cockpit_title"
            style="@style/OpenSwFocusTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@id/cockpit_context"
            app:layout_constraintEnd_toStartOf="@id/cockpit_state"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Pokémon Legends: Arceus" />

        <TextView
            android:id="@+id/cockpit_context"
            style="@style/OpenSwDataText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cockpit_state"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cockpit_title"
            tools:text="01001F5010DFA000" />

        <TextView
            android:id="@+id/cockpit_state"
            style="@style/OpenSwDataText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/cockpit_running"
            android:textColor="@color/opensw_mint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/cockpit_header_rule"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/opensw_outline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cockpit_header" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/cockpit_tabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:checkedButton="@id/cockpit_tab_performance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cockpit_header_rule"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cockpit_tab_performance"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/performance_lab"
            android:textAllCaps="false"
            app:icon="@drawable/ic_frames" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cockpit_tab_cheats"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/cheats"
            android:textAllCaps="false"
            app:icon="@drawable/ic_code" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cockpit_tab_session"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/cockpit_session"
            android:textAllCaps="false"
            app:icon="@drawable/ic_controller" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:id="@+id/cockpit_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cockpit_tabs">

        <include
            android:id="@+id/cockpit_performance_content"
            layout="@layout/layout_performance_panel" />

        <include
            android:id="@+id/cockpit_cheats_content"
            layout="@layout/layout_cheat_panel"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/cockpit_session_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <TextView
                    style="@style/OpenSwDataText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cockpit_session_controls"
                    android:textColor="@color/opensw_cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cockpit_pause"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:nextFocusDown="@id/cockpit_overlay"
                    android:text="@string/emulation_pause"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_pause" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cockpit_overlay"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:nextFocusDown="@id/cockpit_quick_settings"
                    android:nextFocusUp="@id/cockpit_pause"
                    android:text="@string/emulation_show_overlay"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_controller" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cockpit_quick_settings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:nextFocusDown="@id/cockpit_stop"
                    android:nextFocusUp="@id/cockpit_overlay"
                    android:text="@string/quick_settings"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_tune" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cockpit_stop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:nextFocusUp="@id/cockpit_quick_settings"
                    android:text="@string/emulation_exit"
                    android:textAllCaps="false"
                    android:textColor="@color/opensw_yellow"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_exit"
                    app:iconTint="@color/opensw_yellow"
                    app:strokeColor="@color/opensw_yellow" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
